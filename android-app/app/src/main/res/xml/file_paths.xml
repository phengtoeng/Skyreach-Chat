<?xml version="1.0" encoding="utf-8"?>
<!-- Only the decrypted-media directory is shareable, so an ACTION_VIEW intent can play a
     video. Nothing else in app storage (seeds, transcripts, chunks) is exposed. -->
<paths>
    <files-path name="media" path="media/" />
    <!-- Where the camera app writes a capture. Also nothing but photos, and each one is
         deleted as soon as it has been sealed. -->
    <files-path name="capture" path="capture/" />
</paths>
