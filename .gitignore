# Rust
/target/
**/target/

# Android / Gradle (build artifacts + machine-local)
android-app/.gradle/
android-app/build/
# built per-platform with cargo-ndk (see README)
android-app/app/build/
android-app/local.properties
android-app/app/src/main/jniLibs/
android-app/captures/
*.apk
*.aab

# Xcode / iOS (build artifacts + user state)
# the project is generated from ios-app/project.yml — run `xcodegen generate` in ios-app/
ios-app/SplitSeal.xcodeproj/
ios-app/**/build/
ios-app/**/DerivedData/
ios-app/**/*.xcuserstate
ios-app/**/xcuserdata/
*.xcworkspace/xcuserdata/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db
